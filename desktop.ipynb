  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🖥️ Cloud Desktop — VS Code\n",
    "\n",
    "Run an XFCE4 desktop directly inside VS Code / GitHub Codespaces and access it via browser or VS Code's native port forwarding.\n",
    "\n",
    "**Stack:** `Xvfb` + `XFCE4` + `x11vnc` + `noVNC` + `localhost.run` + `Brave Browser`"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📦 Cell 1 — Install Dependencies\n",
    "> Uses `sudo` for non-root VS Code environments."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!sudo apt-get update -qq\n",
    "!sudo apt-get install -y -qq xfce4 x11vnc xvfb dbus-x11 novnc websockify openssh-client 2>/dev/null\n",
    "print('✅ All dependencies ready!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🌐 Cell 2 — Install Brave Browser"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "subprocess.run('curl -fsS https://dl.brave.com/install.sh | sudo sh', shell=True)\n",
    "print('✅ Brave installed!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🖥️ Cell 3 — Start Virtual Display + XFCE4"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, os, time\n",
    "\n",
    "os.environ['DISPLAY'] = ':99'\n",
    "\n",
    "subprocess.Popen('Xvfb :99 -screen 0 1280x800x24 -ac', shell=True,\n",
    "    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "time.sleep(3)\n",
    "print('✅ Xvfb running!')\n",
    "\n",
    "subprocess.Popen('DISPLAY=:99 startxfce4', shell=True,\n",
    "    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "time.sleep(6)\n",
    "print('✅ XFCE4 running!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📡 Cell 4 — Start VNC Server"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, time, os\n",
    "\n",
    "VNC_PASSWORD = '12345678'  # Change if you want\n",
    "home_dir = os.path.expanduser('~')\n",
    "pass_file = os.path.join(home_dir, '.vncpasswd')\n",
    "\n",
    "subprocess.run(f'x11vnc -storepasswd {VNC_PASSWORD} {pass_file}', shell=True,\n",
    "    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "\n",
    "subprocess.Popen(\n",
    "    f'x11vnc -display :99 -rfbauth {pass_file} -rfbport 5900 -forever -loop -shared -noxdamage',\n",
    "    shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "time.sleep(2)\n",
    "print(f'✅ VNC server running (password: {VNC_PASSWORD})')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🖱️ Cell 5 — Start noVNC"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, time\n",
    "subprocess.Popen('websockify --web=/usr/share/novnc/ 6080 localhost:5900', shell=True,\n",
    "    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "time.sleep(2)\n",
    "print('✅ noVNC running on port 6080!')\n",
    "print('💡 VS Code Tip: You can open port 6080 directly from the VS Code Ports tab and append /vnc.html to the URL.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🔗 Cell 6 — Create Public Tunnel via localhost.run (Optional)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, time, os\n",
    "\n",
    "log_file = os.path.expanduser('~/tunnel.log')\n",
    "\n",
    "subprocess.Popen(\n",
    "    f'ssh -o StrictHostKeyChecking=no -o ServerAliveInterval=60 \\\n',
    "    f'-R 80:localhost:6080 nokey@localhost.run \\\n',
    "    f'> {log_file} 2>&1',\n",
    "    shell=True\n",
    ")\n",
    "\n",
    "print('⏳ Starting tunnel...')\n",
    "time.sleep(15)\n",
    "\n",
    "if os.path.exists(log_file):\n",
    "    with open(log_file, 'r') as f:\n",
    "        content = f.read()\n",
    "\n",
    "    found = False\n",
    "    for line in content.split('\\n'):\n",
    "        if 'localhost.run' in line and 'https://' in line:\n",
    "            for word in line.split():\n",
    "                if (word.startswith('https://') and 'localhost.run' in word\n",
    "                        and not any(x in word for x in ['admin.', '/docs'])):\n",
    "                    print('=' * 55)\n",
    "                    print('🎉 Your remote desktop is ready!')\n",
    "                    print(f'🌐 Open: {word.strip()}/vnc.html')\n",
    "                    print(f'🔒 Password: {VNC_PASSWORD}')\n",
    "                    print('=' * 55)\n",
    "                    found = True\n",
    "                    break\n",
    "\n",
    "    if not found:\n",
    "        print('⚠️ Public URL not ready — check Cell 7 or use VS Code Ports panel.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🔍 Cell 7 — Show Full Tunnel Log"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "log_file = os.path.expanduser('~/tunnel.log')\n",
    "if os.path.exists(log_file):\n",
    "    with open(log_file, 'r') as f:\n",
    "        print(f.read())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🚀 Cell 8 — Launch Brave Browser on the Desktop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess, os\n",
    "subprocess.Popen('DISPLAY=:99 brave-browser --no-sandbox', shell=True,\n",
    "    env={**os.environ, 'DISPLAY': ':99'},\n",
    "    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n",
    "print('✅ Brave launched on the desktop!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## ⬇️ Cell 9 (Optional) — Download Model from HuggingFace"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from huggingface_hub import hf_hub_download\n",
    "import shutil, os\n",
    "\n",
    "REPO_ID  = 'your-username/your-model'   # ← Change this\n",
    "FILENAME = 'your-model.safetensors'     # ← Change this\n",
    "\n",
    "home_dir = os.path.expanduser('~')\n",
    "desktop_dir = os.path.join(home_dir, 'Desktop')\n",
    "\n",
    "print(f'⏳ Downloading {FILENAME} from HuggingFace...')\n",
    "path = hf_hub_download(repo_id=REPO_ID, filename=FILENAME, local_dir=home_dir)\n",
    "\n",
    "os.makedirs(desktop_dir, exist_ok=True)\n",
    "shutil.copy(path, os.path.join(desktop_dir, FILENAME))\n",
    "\n",
    "print(f'✅ Downloaded: {path}')\n",
    "print('✅ Copied to Desktop — ready to use!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🛑 Cell 10 — Stop Everything"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "subprocess.run('pkill x11vnc; pkill Xvfb; pkill xfce4-session; pkill websockify; pkill ssh', shell=True)\n",
    "print('🛑 All processes stopped!')"
   ]
  }
 ]
}